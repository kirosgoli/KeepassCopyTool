<Window x:Class="KeepassCopyTool.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeePass Copy Tool"
        Height="530"
        Width="640"
        MinHeight="500"
        MinWidth="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Ustawienia kopii" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Ścieżki i interwał zapisywane w rejestrze użytkownika."
                       Margin="0,4,0,0"
                       Foreground="#666666"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Zapisz" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Plik źródłowy (.kdbx)"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceFilePathTextBox"/>
                <Button Grid.Column="1"
                        Content="Przeglądaj..."
                        Margin="8,0,0,0"
                        Click="BrowseSourceFile_Click"/>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Folder docelowy"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationFolderTextBox"/>
                <Button Grid.Column="1"
                        Content="Przeglądaj..."
                        Margin="8,0,0,0"
                        Click="BrowseDestinationFolder_Click"/>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Częstotliwość kopii"/>
            <ComboBox x:Name="BackupIntervalHoursComboBox"
                      Width="260"
                      HorizontalAlignment="Left"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Hours"
                      SelectionChanged="BackupIntervalHoursComboBox_SelectionChanged"
                      Margin="0,0,0,4"/>
            <StackPanel x:Name="CustomBackupIntervalPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Margin="0,0,0,4">
                <TextBlock Text="Co" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="CustomBackupIntervalHoursTextBox" Width="80"/>
                <TextBlock Text="godzin" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Np. co 6 godzin, raz dziennie lub raz w tygodniu."
                       Foreground="#666666"
                       Margin="0,0,0,12"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Ostatnia aktualizacja ustawień"/>
            <TextBox x:Name="LastSettingsUpdateDateTextBox"
                     IsReadOnly="True"
                     Margin="0,0,0,12"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Ostatnie uruchomienie"/>
            <TextBox x:Name="LastRunDateTextBox" IsReadOnly="True"/>
        </StackPanel>
    </DockPanel>
</Window>
